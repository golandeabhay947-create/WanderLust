<% if (success && success.length) { %>
  <% success.forEach(message => { %>
    <div class="alert alert-success auto-dismiss-alert alert-dismissible fade show col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-2 shadow-sm rounded-4 border-0 d-flex align-items-center gap-2" role="alert">
      <i class="fa-solid fa-circle-check fs-5 text-success"></i>
      <div class="fw-medium flex-grow-1"><%= message %></div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<% if (error && error.length) { %>
  <% error.forEach(message => { %>
    <div class="alert alert-danger auto-dismiss-alert alert-dismissible fade show col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-2 shadow-sm rounded-4 border-0 d-flex align-items-center gap-2" role="alert">
      <i class="fa-solid fa-circle-exclamation fs-5 text-danger"></i>
      <div class="fw-medium flex-grow-1"><%= message %></div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>


