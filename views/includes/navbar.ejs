
<nav class="navbar navbar-expand-lg navbar-custom sticky-top">
  <div class="container-fluid px-lg-4">
    <!-- Brand Logo -->
    <a class="brand-logo" href="/listings">
      <i class="fa-solid fa-compass"></i>
      <span>WanderLust</span>
    </a>

    <!-- Navbar Toggler for Mobile -->
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
      aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <i class="fa-solid fa-bars fs-4"></i>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <!-- Center: Search Bar -->
      <div class="mx-auto my-2 my-lg-0 w-100 d-flex justify-content-center">
        <form class="search-wrapper" action="/listings" method="GET">
          <input 
            class="form-control search-input-pill" 
            type="search" 
            name="q"
            placeholder="Search destinations, villas, price..." 
            value="<%= typeof q !== 'undefined' ? q : '' %>"
            autocomplete="off"
          >
          <button class="search-btn-circle" type="submit" aria-label="Search">
            <i class="fa-solid fa-magnifying-glass fs-6"></i>
          </button>
        </form>
      </div>

      <!-- Right Side Actions -->
      <ul class="navbar-nav align-items-lg-center gap-2 mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-pill-btn nav-host-btn" href="/listings/new">
            <i class="fa-solid fa-plus text-danger"></i>
            <span>Share Your Place</span>
          </a>
        </li>

        <% if (!currUser) { %>
          <li class="nav-item">
            <a class="nav-pill-btn" href="/signup">
              <i class="fa-regular fa-user"></i>
              <span>Sign Up</span>
            </a>
          </li>
          <li class="nav-item">
            <a class="btn btn-primary-custom py-2 px-3 fs-6" href="/login">
              <span>Log In</span>
            </a>
          </li>
        <% } else { %>
          <!-- User Dropdown -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle nav-pill-btn border py-1 ps-2 pe-3 d-flex align-items-center gap-2" 
               href="#" 
               role="button" 
               data-bs-toggle="dropdown" 
               aria-expanded="false">
              <div class="user-avatar-badge">
                <%= currUser.username ? currUser.username.charAt(0).toUpperCase() : 'U' %>
              </div>
              <span class="fw-semibold text-truncate" style="max-width: 110px;"><%= currUser.username %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2 p-2" style="min-width: 210px;">
              <li>
                <div class="px-3 py-2 border-bottom mb-1">
                  <small class="text-muted d-block">Signed in as</small>
                  <strong class="text-dark"><%= currUser.username %></strong>
                </div>
              </li>
              <li>
                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" href="/listings/favourites">
                  <i class="fa-solid fa-heart text-danger"></i>
                  <span>My Favourites</span>
                  <% if (currUser.favourites && currUser.favourites.length) { %>
                    <span class="badge bg-danger rounded-pill ms-auto"><%= currUser.favourites.length %></span>
                  <% } %>
                </a>
              </li>
              <li>
                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" href="/listings/new">
                  <i class="fa-solid fa-house-chimney text-primary"></i>
                  <span>Create Listing</span>
                </a>
              </li>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2 text-danger" href="/logout">
                  <i class="fa-solid fa-arrow-right-from-bracket"></i>
                  <span>Log Out</span>
                </a>
              </li>
            </ul>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
