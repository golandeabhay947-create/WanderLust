    <div class="empty-state-card shadow-sm border">
      <div class="text-danger mb-3">
        <i class="fa-solid fa-triangle-exclamation fs-1"></i>
      </div>
      <h3 class="fw-bold mb-2">Oops! Something went wrong</h3>
      <p class="text-muted mb-4"><%= message || "We couldn't find the page you were looking for." %></p>
      <div class="d-flex justify-content-center gap-2">
        <a href="/listings" class="btn btn-primary-custom px-4 py-2">
          <i class="fa-solid fa-house me-2"></i>Back to Home
        </a>
      </div>
    </div>
  </div>
</div>
