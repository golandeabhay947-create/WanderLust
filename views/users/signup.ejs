<% layout("/layouts/boilerplate.ejs") %>

<div class="container py-4">
  <div class="row justify-content-center my-3">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
      <div class="form-card auth-form-card shadow-sm">
        <div class="text-center mb-4">
          <div class="auth-brand-badge mb-2">
            <i class="fa-solid fa-compass"></i>
          </div>
          <h4 class="fw-bold mb-1">Create Account</h4>
          <p class="text-muted small mb-0">Join WanderLust to discover and save unique stays worldwide</p>
        </div>

        <form action="/signup" method="POST" class="needs-validation" novalidate>
          <!-- Username -->
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 rounded-start-2"><i class="fa-regular fa-user"></i></span>
              <input 
                type="text" 
                name="username" 
                id="username"
                class="form-control form-control-custom rounded-end-2" 
                placeholder="e.g. wanderer123"
                minlength="3"
                required
                autofocus
              >
            </div>
            <div class="invalid-feedback">Username is required (min 3 characters).</div>
          </div>

          <!-- Email -->
          <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 rounded-start-2"><i class="fa-regular fa-envelope"></i></span>
              <input 
                type="email" 
                name="email"
                id="email" 
                class="form-control form-control-custom rounded-end-2" 
                placeholder="name@example.com"
                required
              >
            </div>
            <div class="invalid-feedback">Please enter a valid email address.</div>
          </div>

          <!-- Password -->
          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <div class="input-group position-relative">
              <span class="input-group-text bg-light border-end-0 rounded-start-2"><i class="fa-solid fa-lock"></i></span>
              <input 
                type="password" 
                name="password" 
                id="password" 
                class="form-control form-control-custom pe-5 rounded-end-2" 
                placeholder="Create a password (min 6 characters)"
                minlength="6"
                required
              >
              <i class="bi bi-eye-slash position-absolute text-muted" id="togglePassword"
                style="top: 50%; right: 14px; transform: translateY(-50%); cursor: pointer; z-index: 5; font-size: 0.95rem;">
              </i>
            </div>
            <div class="invalid-feedback">Password must be at least 6 characters.</div>
          </div>

          <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6 fw-bold mb-3">
            <i class="fa-solid fa-user-plus me-2"></i>Create Account
          </button>

          <p class="text-center text-muted small mb-0">
            Already have an account? 
            <a href="/login" class="fw-bold text-danger text-decoration-none">Log In</a>
          </p>
        </form>
      </div>
    </div>
  </div>
</div>
