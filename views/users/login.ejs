<% layout("/layouts/boilerplate.ejs") %>

<div class="container py-4">
  <div class="row justify-content-center my-3">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
      <div class="form-card auth-form-card shadow-sm">
        <div class="text-center mb-4">
          <div class="auth-brand-badge mb-2">
            <i class="fa-solid fa-compass"></i>
          </div>
          <h4 class="fw-bold mb-1">Welcome Back</h4>
          <p class="text-muted small mb-0">Log in to your WanderLust account to manage your stays and favourites</p>
        </div>

        <form action="/login" method="POST" class="needs-validation" novalidate>
          <!-- Username -->
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 rounded-start-2"><i class="fa-regular fa-user"></i></span>
              <input 
                type="text" 
                name="username" 
                id="username"
                class="form-control form-control-custom rounded-end-2"
                placeholder="Enter your username"
                required
                autofocus
              >
            </div>
            <div class="invalid-feedback">Please enter your username.</div>
          </div>

          <!-- Password -->
          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <div class="input-group position-relative">
              <span class="input-group-text bg-light border-end-0 rounded-start-2"><i class="fa-solid fa-lock"></i></span>
              <input 
                type="password" 
                name="password" 
                id="password"
                class="form-control form-control-custom pe-5 rounded-end-2" 
                placeholder="Enter your password" 
                required
              >
              <i class="bi bi-eye-slash position-absolute text-muted" id="togglePassword"
                style="top: 50%; right: 14px; transform: translateY(-50%); cursor: pointer; z-index: 5; font-size: 0.95rem;">
              </i>
            </div>
            <div class="invalid-feedback">Please enter your password.</div>
          </div>

          <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6 fw-bold mb-3">
            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Log In
          </button>

          <p class="text-center text-muted small mb-0">
            Don't have an account? 
            <a href="/signup" class="fw-bold text-danger text-decoration-none">Sign Up</a>
          </p>
        </form>
      </div>
    </div>
  </div>
</div>
