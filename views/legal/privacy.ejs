<% layout("/layouts/boilerplate.ejs") %>

<div class="container py-4">
  <div class="row justify-content-center my-3">
    <div class="col-12 col-md-10 col-lg-8">
      <div class="form-card">
        <div class="text-center mb-4">
          <div class="auth-brand-badge mb-3">
            <i class="fa-solid fa-user-shield"></i>
          </div>
          <h2 class="fs-4 fw-bold mb-1">Privacy Policy</h2>
          <p class="text-muted small mb-0">
            Last Updated: <%= new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
          </p>
        </div>

        <hr class="mb-4">

        <div class="text-secondary small leading-relaxed" style="line-height: 1.8;">
          <p><strong class="text-dark">1. Overview:</strong> WanderLust is committed to protecting your privacy. This policy explains how we collect, use, and safeguard your personal details.</p>
          <p><strong class="text-dark">2. Data We Collect:</strong> We collect necessary account details (such as username, email address, and hashed authentication data), listing submissions, and reviews.</p>
          <p><strong class="text-dark">3. Purpose of Processing:</strong> We use your data to maintain account authentication, present your favourite stays, display public property listings, and secure platform sessions.</p>
          <p><strong class="text-dark">4. Security Measures:</strong> Passwords are cryptographically salted and hashed using industry standards (Passport Local Mongoose & pbkdf2). Sensitive tokens and sessions are protected.</p>
          <p><strong class="text-dark">5. Cookies & Local Sessions:</strong> We utilize encrypted HTTP cookies to maintain login authentication and stateful sessions.</p>
          <p><strong class="text-dark">6. Your Rights:</strong> You can edit or delete your listings, reviews, and account details at any time through your dashboard.</p>
        </div>

        <div class="text-center mt-4 pt-3 border-top">
          <a href="/listings" class="btn btn-primary-custom px-4 py-2">
            <i class="fa-solid fa-compass me-2"></i>Back to Listings
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
