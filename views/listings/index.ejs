<% layout("/layouts/boilerplate.ejs") %>

<!-- Category Filters & Tax Switch Bar -->
<div class="filters-container mb-4">
  <div class="category-scroll-wrapper">
    <a href="/listings" class="filter-item <%= !category ? 'active' : '' %>">
      <i class="fa-solid fa-border-all"></i>
      <span>All</span>
    </a>

    <a href="/listings?category=Trending" class="filter-item <%= category === 'Trending' ? 'active' : '' %>">
      <i class="fa-solid fa-fire"></i>
      <span>Trending</span>
    </a>

    <a href="/listings?category=Rooms" class="filter-item <%= category === 'Rooms' ? 'active' : '' %>">
      <i class="fa-solid fa-bed"></i>
      <span>Rooms</span>
    </a>

    <a href="/listings?category=Beach" class="filter-item <%= category === 'Beach' ? 'active' : '' %>">
      <i class="fa-solid fa-umbrella-beach"></i>
      <span>Beach</span>
    </a>

    <a href="/listings?category=Mountains" class="filter-item <%= category === 'Mountains' ? 'active' : '' %>">
      <i class="fa-solid fa-mountain"></i>
      <span>Mountains</span>
    </a>

    <a href="/listings?category=Camping" class="filter-item <%= category === 'Camping' ? 'active' : '' %>">
      <i class="fa-solid fa-campground"></i>
      <span>Camping</span>
    </a>

    <a href="/listings?category=City" class="filter-item <%= category === 'City' ? 'active' : '' %>">
      <i class="fa-solid fa-city"></i>
      <span>Iconic Cities</span>
    </a>

    <a href="/listings?category=Pool" class="filter-item <%= category === 'Pool' ? 'active' : '' %>">
      <i class="fa-solid fa-water-ladder"></i>
      <span>Amazing Pools</span>
    </a>

    <a href="/listings?category=Nature" class="filter-item <%= category === 'Nature' ? 'active' : '' %>">
      <i class="fa-solid fa-tree"></i>
      <span>Nature</span>
    </a>

    <a href="/listings?category=Heritage" class="filter-item <%= category === 'Heritage' ? 'active' : '' %>">
      <i class="fa-solid fa-landmark"></i>
      <span>Heritage</span>
    </a>

    <a href="/listings?category=Islands" class="filter-item <%= category === 'Islands' ? 'active' : '' %>">
      <i class="fa-solid fa-water"></i>
      <span>Islands</span>
    </a>
  </div>

  <!-- Tax Switch -->
  <div class="tax-toggle-box">
    <div class="form-check form-switch form-check-reverse m-0">
      <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>

<!-- Active Search / Filter Banner (if applied) -->
<% if (category || (typeof searchQuery !== 'undefined' && searchQuery)) { %>
  <div class="d-flex align-items-center justify-content-between mb-3 py-2 px-3 bg-light rounded-3">
    <div class="small text-muted">
      <% if (searchQuery) { %>
        Search results for: <strong>"<%= searchQuery %>"</strong>
      <% } %>
      <% if (category) { %>
        Filtered by: <span class="badge bg-danger rounded-pill"><%= category %></span>
      <% } %>
      (<%= allListing.length %> places found)
    </div>
    <a href="/listings" class="btn btn-sm btn-outline-secondary rounded-pill">
      <i class="fa-solid fa-xmark me-1"></i> Clear Filters
    </a>
  </div>
<% } %>

<!-- Listings Grid -->
<% if (!allListing || allListing.length === 0) { %>
  <div class="empty-state-card mt-4">
    <i class="fa-solid fa-compass empty-state-icon"></i>
    <h3 class="fw-bold mb-2">No Destinations Found</h3>
    <p class="text-muted mb-4">We couldn't find any stays matching your criteria. Try adjusting your search or category.</p>
    <a href="/listings" class="btn btn-primary-custom px-4 py-2">
      <i class="fa-solid fa-rotate-left me-2"></i>View All Listings
    </a>
  </div>
<% } else { %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
    <% for(let listing of allListing) { %>
      <div class="col">
        <div class="listing-card">
          <!-- Image Container -->
          <div class="card-img-container">
            <a href="/listings/<%= listing._id %>" class="listing-card-link">
              <img 
                src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60' %>" 
                class="listing-img" 
                alt="<%= listing.title %>"
                loading="lazy"
              >
            </a>

            <!-- Category Badge -->
            <% if (listing.category) { %>
              <span class="card-category-badge"><%= listing.category %></span>
            <% } %>

            <!-- Favorite Heart Button -->
            <% if (currUser) { %>
              <form action="/listings/<%= listing._id %>/favourite" method="POST" class="d-inline">
                <button type="submit" class="card-fav-btn <%= (currUser.favourites && currUser.favourites.some(fav => fav.equals(listing._id))) ? 'active' : '' %>" title="Save to favourites">
                  <i class="bi <%= (currUser.favourites && currUser.favourites.some(fav => fav.equals(listing._id))) ? 'bi-heart-fill text-danger' : 'bi-heart' %>"></i>
                </button>
              </form>
            <% } %>
          </div>

          <!-- Card Info Body -->
          <a href="/listings/<%= listing._id %>" class="listing-card-link">
            <div class="listing-card-body">
              <div class="d-flex justify-content-between align-items-baseline">
                <h6 class="listing-title mb-1" title="<%= listing.title %>"><%= listing.title %></h6>
              </div>
              <div class="listing-location">
                <i class="fa-solid fa-location-dot me-1 text-muted"></i>
                <%= listing.location ? listing.location : '' %><% if (listing.location && listing.country) { %>, <% } %><%= listing.country ? listing.country : '' %>
              </div>
              <div class="listing-price mt-1">
                <span>&#8377;</span>
                <span class="listing-price-value" data-base-price="<%= listing.price || 0 %>">
                  <%= (listing.price || 0).toLocaleString("en-IN") %>
                </span>
                <span class="text-muted fw-normal small">/ night</span>
                <span class="tax-info d-none">+18% GST</span>
              </div>
            </div>
          </a>
        </div>
      </div>
    <% } %>
  </div>
<% } %>
