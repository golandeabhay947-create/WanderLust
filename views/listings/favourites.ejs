<% layout("/layouts/boilerplate.ejs") %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3 pt-1 flex-wrap gap-2">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <a href="/listings" class="text-decoration-none text-muted small"><i class="fa-solid fa-arrow-left me-1"></i>Back to Explore</a>
      </div>
      <h4 class="fw-bold mb-1">My Saved Favourites <i class="fa-solid fa-heart text-danger fs-5 ms-1"></i></h4>
      <p class="text-muted small mb-0">Your curated collection of dream destinations and stays</p>
    </div>
    <% if (allListing && allListing.length > 0) { %>
      <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1.5 fw-bold small">
        <%= allListing.length %> <%= allListing.length === 1 ? 'Stay Saved' : 'Stays Saved' %>
      </span>
    <% } %>
  </div>

  <% if (!allListing || allListing.length === 0) { %>
    <div class="empty-state-card my-4 shadow-sm">
      <div class="empty-state-icon-box">
        <i class="fa-regular fa-heart"></i>
      </div>
      <h5 class="fw-bold mb-2">No favourites saved yet</h5>
      <p class="text-muted small mb-4">Start discovering amazing stays around the world and tap the heart icon on any card to save it here.</p>
      <a href="/listings" class="btn btn-primary-custom px-4 py-2">
        <i class="fa-solid fa-compass me-2"></i>Explore Stays Now
      </a>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3 g-md-4 listings-grid">
      <% for(let listing of allListing) { %>
        <% if (!listing) continue; %>
        <div class="col">
          <div class="listing-card">
            <!-- Image Container -->
            <div class="card-img-container">
              <a href="/listings/<%= listing._id %>" class="listing-card-link" aria-label="<%= listing.title %>">
                <img 
                  src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60' %>" 
                  class="listing-img" 
                  alt="<%= listing.title %>"
                  loading="lazy"
                >
              </a>

              <!-- Category Badge -->
              <% if (listing.category) { %>
                <span class="card-category-badge">
                  <i class="fa-solid fa-tag me-1"></i><%= listing.category %>
                </span>
              <% } %>

              <!-- Favorite Heart Button (Allows removing directly) -->
              <form action="/listings/<%= listing._id %>/favourite" method="POST" class="d-inline">
                <button type="submit" class="card-fav-btn active" title="Remove from favourites" aria-label="Remove favourite">
                  <i class="bi bi-heart-fill text-danger"></i>
                </button>
              </form>
            </div>

            <!-- Card Info Body -->
            <a href="/listings/<%= listing._id %>" class="listing-card-link">
              <div class="listing-card-body">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <h6 class="listing-title mb-0" title="<%= listing.title %>"><%= listing.title %></h6>
                  <div class="listing-rating-pill">
                    <i class="fa-solid fa-star text-warning me-1"></i>
                    <span>4.9</span>
                  </div>
                </div>

                <div class="listing-location">
                  <i class="fa-solid fa-location-dot me-1 text-muted"></i>
                  <%= listing.location ? listing.location : '' %><% if (listing.location && listing.country) { %>, <% } %><%= listing.country ? listing.country : '' %>
                </div>

                <div class="listing-perk-badge">
                  <i class="fa-solid fa-check text-success"></i>Free cancellation
                </div>

                <div class="listing-price-container">
                  <div class="d-flex align-items-baseline gap-1">
                    <span class="price-currency">&#8377;</span>
                    <span class="listing-price-value" data-base-price="<%= listing.price || 0 %>">
                      <%= (listing.price || 0).toLocaleString("en-IN") %>
                    </span>
                    <span class="text-muted fw-normal small">/ night</span>
                  </div>
                </div>
              </div>
            </a>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>