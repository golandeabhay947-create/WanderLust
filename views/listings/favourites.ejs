<% layout("/layouts/boilerplate.ejs") %>

<div class="d-flex justify-content-between align-items-center mb-4 pt-2">
  <div>
    <h2 class="fw-bold mb-1">My Favourites <i class="fa-solid fa-heart text-danger fs-4 ms-1"></i></h2>
    <p class="text-muted small mb-0">Saved listings that you love</p>
  </div>
  <% if (allListing && allListing.length > 0) { %>
    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-bold">
      <%= allListing.length %> <%= allListing.length === 1 ? 'place saved' : 'places saved' %>
    </span>
  <% } %>
</div>

<% if (!allListing || allListing.length === 0) { %>
  <div class="empty-state-card my-5">
    <i class="fa-regular fa-heart empty-state-icon"></i>
    <h3 class="fw-bold mb-2">No favourites yet</h3>
    <p class="text-muted mb-4">Start exploring amazing stays around the world and tap the heart icon to save your favourites.</p>
    <a href="/listings" class="btn btn-primary-custom px-4 py-2">
      <i class="fa-solid fa-compass me-2"></i>Explore Now
    </a>
  </div>
<% } else { %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
    <% for(let listing of allListing) { %>
      <% if (!listing) continue; %>
      <div class="col">
        <div class="listing-card">
          <!-- Image Container -->
          <div class="card-img-container">
            <a href="/listings/<%= listing._id %>" class="listing-card-link">
              <img 
                src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60' %>" 
                class="listing-img" 
                alt="<%= listing.title %>"
                loading="lazy"
              >
            </a>

            <!-- Category Badge -->
            <% if (listing.category) { %>
              <span class="card-category-badge"><%= listing.category %></span>
            <% } %>

            <!-- Favorite Heart Button (Allows removing directly) -->
            <form action="/listings/<%= listing._id %>/favourite" method="POST" class="d-inline">
              <button type="submit" class="card-fav-btn active" title="Remove from favourites">
                <i class="bi bi-heart-fill text-danger"></i>
              </button>
            </form>
          </div>

          <!-- Card Info Body -->
          <a href="/listings/<%= listing._id %>" class="listing-card-link">
            <div class="listing-card-body">
              <h6 class="listing-title mb-1" title="<%= listing.title %>"><%= listing.title %></h6>
              <div class="listing-location">
                <i class="fa-solid fa-location-dot me-1 text-muted"></i>
                <%= listing.location %><% if (listing.location && listing.country) { %>, <% } %><%= listing.country %>
              </div>
              <div class="listing-price mt-1">
                <span>&#8377;</span>
                <span class="listing-price-value" data-base-price="<%= listing.price || 0 %>">
                  <%= (listing.price || 0).toLocaleString("en-IN") %>
                </span>
                <span class="text-muted fw-normal small">/ night</span>
              </div>
            </div>
          </a>
        </div>
      </div>
    <% } %>
  </div>
<% } %>